{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tanstack-start-app",
	"compatibility_date": "2025-09-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/server.ts",
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "contract-index",
			"remote": true
		}
	],
	"d1_databases": [
		{
			"binding": "contract_db",
			"database_name": "contract-db",
			"database_id": "d7730b39-11f1-44e8-8c10-b79ff5a56ea6",
			"remote": true
		}
	],
}